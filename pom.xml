<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.amazon.automation</groupId>
  <artifactId>amazon-selenium-tests</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Amazon Selenium Automation – TestMu AI Assignment</name>
  <description>
    Automated test cases using Selenium + Java + TestNG.
    TC1: iPhone search, add to cart, print price.
    TC2: Galaxy search, add to cart, print price.
    Both tests run in parallel via TestNG suite XML.
    Bonus: LambdaTest cloud execution supported.
  </description>

  <properties>
    <java.version>11</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Dependency versions -->
    <selenium.version>4.18.1</selenium.version>
    <testng.version>7.9.0</testng.version>
    <webdrivermanager.version>5.8.0</webdrivermanager.version>
    <slf4j.version>2.0.12</slf4j.version>
    <dotenv.version>3.0.0</dotenv.version>
  </properties>

  <dependencies>

    <!-- ── Selenium WebDriver ───────────────────────────────────────── -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
    </dependency>

    <!-- ── TestNG test framework ────────────────────────────────────── -->
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
    </dependency>

    <!-- ── WebDriverManager – auto-downloads browser drivers ────────── -->
    <dependency>
      <groupId>io.github.bonigarcia</groupId>
      <artifactId>webdrivermanager</artifactId>
      <version>${webdrivermanager.version}</version>
    </dependency>

    <!-- ── dotenv-java – load .env for LambdaTest credentials ────────  -->
    <dependency>
      <groupId>io.github.cdimascio</groupId>
      <artifactId>dotenv-java</artifactId>
      <version>${dotenv.version}</version>
    </dependency>

    <!-- ── SLF4J (required by WebDriverManager) ─────────────────────  -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- Maven Compiler Plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
        </configuration>
      </plugin>

      <!-- Maven Surefire Plugin – runs TestNG suites -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- Default: local parallel suite -->
          <suiteXmlFiles>
            <suiteXmlFile>${suiteFile}</suiteXmlFile>
          </suiteXmlFiles>
          <!-- Pass all -D system properties into the forked JVM -->
          <systemPropertyVariables>
            <LT_USERNAME>${LT_USERNAME}</LT_USERNAME>
            <LT_ACCESS_KEY>${LT_ACCESS_KEY}</LT_ACCESS_KEY>
            <RUN_ON_LT>${RUN_ON_LT}</RUN_ON_LT>
          </systemPropertyVariables>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <!-- ── Default property values (overridden via -D flags) ─────────── -->
  <profiles>
    <profile>
      <id>local</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties>
        <suiteFile>testng.xml</suiteFile>
        <RUN_ON_LT>false</RUN_ON_LT>
        <LT_USERNAME></LT_USERNAME>
        <LT_ACCESS_KEY></LT_ACCESS_KEY>
      </properties>
    </profile>
    <profile>
      <id>lambdatest</id>
      <properties>
        <suiteFile>testng-lambdatest.xml</suiteFile>
        <RUN_ON_LT>true</RUN_ON_LT>
      </properties>
    </profile>
  </profiles>

</project>
